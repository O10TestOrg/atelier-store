{
    "permissions":{
        "allow":[
            "Bash(pnpm build)",
            "Bash(pnpm lint)",
            "Bash(pnpm test)",
            "Bash(pnpm typecheck)",
            "Bash(git status)",
            "Bash(git diff *)"
        ],
        "ask":[
            "Bash(git push *)"
        ],
        "deny":[
            "Read(.env)",
            "Read(.env.local)",
            "Read(.env.*.local)",
            "Read(.env.development)",
            "Read(.env.production)",
            "Read(.env.test)",
            "Edit(.env)",
            "Edit(.env.local)",
            "Edit(.env.*.local)",
            "Edit(.env.development)",
            "Edit(.env.production)",
            "Edit(.env.test)"
        ]
    }
}
