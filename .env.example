# Neon Postgres connection string (Neon dashboard → Connect)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Stripe — a restricted rk_ key from a sandbox, and the whsec_ secret printed by `stripe listen`
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Public origin for Stripe return URLs and email links. Vercel previews use their own URL instead
APP_URL="http://localhost:3000"

# Bearer token for the scheduled stock-hold sweep at /api/cron/release-holds (openssl rand -base64 32)
CRON_SECRET=""

# Resend, for verification, order-link and back-in-stock emails. Unset in dev: emails print to the server console
RESEND_API_KEY=""
# A sender on a domain verified in Resend, e.g. "Atelier <orders@yourdomain.com>"
EMAIL_FROM=""

# Vercel Blob read-write token, for product photo uploads in /admin. Unset: uploads are off and images must be Unsplash URLs.
# Needed at build time too, so next/image allows the store's host.
BLOB_READ_WRITE_TOKEN=""

# Contact and reply-to address shown on /help/contact and in emails. Read at build time.
CLIENT_SERVICES_EMAIL=""

# Public demo. "1" shows a banner with the Stripe test card and the read-only admin login
# below. All three are read at build time, so redeploy after changing them.
NEXT_PUBLIC_DEMO_MODE=""
# The `viewer` account `pnpm db:seed-demo` creates (default demo@atelier.example). The seed reads
# the password to set it; the banner shows both.
DEMO_VIEWER_EMAIL=""
DEMO_VIEWER_PASSWORD=""
